<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- One visible Quantity/Unit/Unit Price. Native base values remain hidden
         for Odoo stock/accounting computations and backend validation. -->
    <record id="ya_purchase_order_uom_form" model="ir.ui.view">
        <field name="name">ya.purchase.order.uom.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//field[@name='product_qty']" position="replace">
                <field name="product_qty" invisible="1" column_invisible="True"/>
                <field name="ya_purchase_qty" string="Quantity"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='product_uom_id']" position="replace">
                <field name="product_uom_id" invisible="1" column_invisible="True"/>
                <field name="ya_purchase_rule_id" string="Unit"
                       domain="[('product_id', '=', product_id), ('active', '=', True)]"
                       options="{'no_create': True, 'no_open': True}"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='price_unit']" position="replace">
                <field name="price_unit" invisible="1" column_invisible="True"/>
                <field name="ya_purchase_price" string="Unit Price"/>
            </xpath>
        </field>
    </record>
</odoo>
