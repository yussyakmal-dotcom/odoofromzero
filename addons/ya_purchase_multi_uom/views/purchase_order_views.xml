<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Native quantity is kept visible for transparent stock conversion. -->
    <record id="ya_purchase_order_uom_form" model="ir.ui.view">
        <field name="name">ya.purchase.order.uom.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//field[@name='product_qty']" position="after">
                <field name="ya_purchase_rule_id" optional="show"/>
                <field name="ya_purchase_qty" optional="show"/>
                <field name="ya_purchase_price" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
