<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ya_purchase_uom_rule_list" model="ir.ui.view">
        <field name="name">ya.purchase.uom.rule.list</field>
        <field name="model">ya.purchase.uom.rule</field>
        <field name="arch" type="xml">
            <list string="Master Multi-UoM YA" default_order="product_id,purchase_label">
                <field name="product_id" string="Produk / SKU"/>
                <field name="base_uom_id" string="Satuan Dasar" readonly="1"/>
                <field name="purchase_label" string="Satuan Pembelian"/>
                <field name="factor" string="Isi per Satuan"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_ya_purchase_uom_rule_form" model="ir.ui.view">
        <field name="name">ya.purchase.uom.rule.form</field>
        <field name="model">ya.purchase.uom.rule</field>
        <field name="arch" type="xml">
            <form string="Aturan Satuan Pembelian YA">
                <sheet>
                    <group>
                        <field name="product_id" options="{'no_create': True}"/>
                        <field name="base_uom_id" readonly="1"/>
                        <field name="purchase_label"/>
                        <field name="factor"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_ya_purchase_uom_rule_search" model="ir.ui.view">
        <field name="name">ya.purchase.uom.rule.search</field>
        <field name="model">ya.purchase.uom.rule</field>
        <field name="arch" type="xml">
            <search string="Cari Aturan Pembelian YA">
                <field name="product_id"/>
                <field name="purchase_label"/>
                <filter name="active_only" string="Aktif" domain="[('active','=',True)]"/>
                <filter name="archived" string="Arsip" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>
    <record id="action_ya_purchase_uom_rule" model="ir.actions.act_window">
        <field name="name">Master Multi-UoM YA</field>
        <field name="res_model">ya.purchase.uom.rule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
    <menuitem id="menu_ya_purchase_uom_rule"
              name="Master Multi-UoM YA"
              parent="purchase.menu_purchase_config"
              action="action_ya_purchase_uom_rule"
              groups="purchase.group_purchase_manager"
              sequence="60"/>
</odoo>
