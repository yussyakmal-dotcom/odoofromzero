<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ya_consolidation_timer_queue_list" model="ir.ui.view">
    <field name="name">ya.consolidation.timer.queue.list</field>
    <field name="model">ya.consolidation.timer.queue</field>
    <field name="arch" type="xml">
      <list create="false" edit="false" delete="false"
            decoration-danger="state == 'blocked' or state == 'expired'"
            decoration-success="state == 'ready'">
        <header>
          <button name="action_refresh_queue" type="object" string="Refresh Antrean" display="always"
                  groups="ya_store_ro.group_ya_packing_admin"/>
        </header>
        <field name="delivery_date" options="{'numeric': True}"/>
        <field name="slot"/>
        <field name="stage"/>
        <field name="state"/>
        <field name="sku_count" string="SKU Review"/>
        <field name="note"/>
        <field name="prepared_at" options="{'numeric': True}"/>
        <field name="batch_id" optional="show"/>
        <button name="action_open_review" type="object" string="Buka Review"
                invisible="state in ('released','expired')"
                groups="ya_store_ro.group_ya_packing_admin"/>
      </list>
    </field>
  </record>
  <record id="action_ya_consolidation_timer_queue" model="ir.actions.act_window">
    <field name="name">Antrean PP1 / PP2</field>
    <field name="res_model">ya.consolidation.timer.queue</field>
    <field name="view_mode">list</field>
    <field name="view_id" ref="view_ya_consolidation_timer_queue_list"/>
    <field name="help" type="html">
      <p>Antrean bersumber dari RO / RO Paket / SO Konsolidasi Confirmed.</p>
      <p>Refresh Antrean tidak menutup pesanan atau menerbitkan MO. PP2 muncul setelah Produksi OK 1.</p>
    </field>
  </record>
  <record id="action_ya_consolidation_queue_refresh" model="ir.actions.server">
    <field name="name">Buka Antrean PP1 / PP2</field>
    <field name="model_id" ref="model_ya_consolidation_timer_queue"/>
    <field name="state">code</field>
    <field name="code">action = model.action_refresh_queue()</field>
  </record>
  <menuitem id="menu_ya_consolidation_timer_queue" name="Antrean PP1 / PP2"
            parent="ya_workflow_navigation.menu_ya_before_production"
            action="action_ya_consolidation_queue_refresh" sequence="54"
            groups="ya_store_ro.group_ya_packing_admin"/>
</odoo>
