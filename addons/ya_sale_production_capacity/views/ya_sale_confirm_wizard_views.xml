<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ya_sale_capacity_confirm_wizard_form" model="ir.ui.view">
    <field name="name">ya.sale.capacity.confirm.wizard.form</field>
    <field name="model">ya.sale.capacity.confirm.wizard</field>
    <field name="arch" type="xml">
      <form string="Konfirmasi Custom Sales Order — Jadwal Kirim">
        <group>
          <field name="order_id" readonly="1"/>
          <field name="delivery_date" options="{'numeric': True}" required="1"/>
          <field name="slot" required="1"/>
        </group>
        <field name="impact_digest" invisible="1"/>
        <field name="impact_table" nolabel="1" readonly="1"/>
        <footer>
          <button name="action_review_impact" type="object" string="Simulasi Dampak"/>
          <button name="action_check_and_confirm" type="object"
                  string="Confirm Sales Order — Reservasi Kapasitas" class="btn-primary" invisible="not impact_digest"/>
          <button string="Batal" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
