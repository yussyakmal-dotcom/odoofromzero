<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ya_quotation_discount_wizard_form" model="ir.ui.view">
    <field name="name">ya.sale.quotation.discount.wizard.form</field>
    <field name="model">ya.sale.quotation.discount.wizard</field>
    <field name="arch" type="xml">
      <form string="Discount">
        <sheet>
          <field name="order_id" invisible="1"/>
          <field name="currency_id" invisible="1"/>
          <div class="row">
            <div class="col-sm-5 col-md-4 col-lg-4 col-4">
              <group>
                <field name="percentage" string="Discount (%)"
                       invisible="discount_type in ('one_amount', 'global_amount')"/>
                <field name="amount" string="Discount (Rp)"
                       invisible="discount_type not in ('one_amount', 'global_amount')"/>
                <field name="line_id" string="Product Line"
                       invisible="discount_type not in ('one_percent', 'one_amount')"/>
              </group>
            </div>
            <div class="col-sm-7 col-md-8 col-lg-8 col-8">
              <field name="discount_type" widget="radio" nolabel="1"/>
            </div>
          </div>
        </sheet>
        <footer>
          <button name="action_apply_discount" type="object"
                  string="Apply" class="btn btn-primary"/>
          <button string="Discard" special="cancel" class="btn btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
