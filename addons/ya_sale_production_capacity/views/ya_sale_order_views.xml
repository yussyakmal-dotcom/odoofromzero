<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Fase 2: dedicated primary form for the YA action.
       Do NOT globally inherit/change the native Sales order form. -->
  <record id="view_ya_capacity_sale_order_form" model="ir.ui.view">
    <field name="name">sale.order.form.ya.production.capacity</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <!-- YA fields are visible/editable at Draft/Sent quotation but OPTIONAL.
           Only the Confirm gate checks date, slot, Published Planning, capacity.
           After confirmation, keep the YA schedule read-only. -->
      <xpath expr="//field[@name='payment_term_id']" position="after">
        <field name="ya_is_capacity_so" invisible="1"/>
        <field name="ya_delivery_date" string="YA Tanggal Kirim"
               readonly="state not in ('draft', 'sent')"/>
        <field name="ya_delivery_date_label" string="Format YYYY-Mon-DD"
               readonly="1" invisible="not ya_delivery_date"/>
        <field name="ya_slot" string="YA Slot Kirim"
               readonly="state not in ('draft', 'sent')"/>
      </xpath>
    </field>
  </record>

  <record id="view_ya_capacity_sale_order_list" model="ir.ui.view">
    <field name="name">sale.order.list.ya.production.capacity</field>
    <field name="model">sale.order</field>
    <field name="arch" type="xml">
      <list string="Sales Order — YA Production Capacity"
            decoration-muted="state == 'cancel'">
        <field name="name"/>
        <field name="partner_id"/>
        <field name="ya_delivery_date_label" string="YA Tanggal Kirim"/>
        <field name="ya_slot" string="Slot"/>
        <field name="state"/>
        <field name="amount_total" sum="Total"/>
      </list>
    </field>
  </record>

  <record id="action_ya_capacity_sale_orders" model="ir.actions.act_window">
    <field name="name">Sales Order — Pengadaan Produk Jadi</field>
    <field name="res_model">sale.order</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('ya_is_capacity_so', '=', True)]</field>
    <field name="context">{'default_ya_is_capacity_so': True}</field>
  </record>
  <record id="action_ya_capacity_sale_orders_list_view"
          model="ir.actions.act_window.view">
    <field name="sequence" eval="1"/>
    <field name="view_mode">list</field>
    <field name="view_id" ref="view_ya_capacity_sale_order_list"/>
    <field name="act_window_id" ref="action_ya_capacity_sale_orders"/>
  </record>
  <record id="action_ya_capacity_sale_orders_form_view"
          model="ir.actions.act_window.view">
    <field name="sequence" eval="2"/>
    <field name="view_mode">form</field>
    <field name="view_id" ref="view_ya_capacity_sale_order_form"/>
    <field name="act_window_id" ref="action_ya_capacity_sale_orders"/>
  </record>

  <menuitem id="menu_ya_capacity_sale_orders"
            name="Sales Order"
            parent="ya_workflow_navigation.menu_ya_before_production"
            action="action_ya_capacity_sale_orders"
            sequence="18"
            groups="sales_team.group_sale_salesman"/>
</odoo>
