<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ya_purchase_discount_wizard_form" model="ir.ui.view">
        <field name="name">ya.purchase.discount.wizard.form</field>
        <field name="model">ya.purchase.discount.wizard</field>
        <field name="arch" type="xml">
            <form string="Discount">
                <sheet>
                    <field name="order_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <div class="row">
                        <div class="col-sm-5 col-md-4 col-lg-4 col-4">
                            <group>
                                <field name="discount_percentage" string="Discount (%)"
                                       invisible="discount_type in ('one_line_amount', 'global_amount')"/>
                                <field name="discount_amount" string="Discount (Rp)"
                                       invisible="discount_type not in ('one_line_amount', 'global_amount')"/>
                                <field name="line_id" string="Product Line"
                                       invisible="discount_type not in ('one_line_percent', 'one_line_amount')"/>
                            </group>
                        </div>
                        <div class="col-sm-7 col-md-8 col-lg-8 col-8">
                            <field name="discount_type" widget="radio" nolabel="1"/>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button type="object" name="action_apply_discount" string="Apply"
                            class="btn btn-primary"/>
                    <button special="cancel" string="Discard" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="ya_purchase_discount_wizard_action" model="ir.actions.act_window">
        <field name="name">Discount</field>
        <field name="res_model">ya.purchase.discount.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="ya_purchase_discount_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
