<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ya_purchase_discount_order_form" model="ir.ui.view">
        <field name="name">ya.purchase.discount.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']" position="before">
                <field name="ya_discount_mode" invisible="1"/>
                <field name="ya_global_discount_type" invisible="1"/>
                <field name="ya_global_discount_value" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']" position="after">
                <div class="text-end mt-2 mb-2">
                    <button type="object" name="action_open_ya_discount_wizard"
                            string="Discount" class="btn btn-secondary"
                            invisible="state not in ('draft', 'sent')"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='ya_purchase_price']" position="after">
                <field name="discount" string="Disc.%" readonly="1" width="75px"/>
            </xpath>
        </field>
    </record>
</odoo>
