<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ya_purchase_discount_order_form" model="ir.ui.view">
        <field name="name">ya.purchase.discount.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']" position="after">
                <group string="Diskon Pembelian" col="4">
                    <field name="ya_discount_mode" string="Mode Diskon"/>
                    <field name="ya_global_discount_type"
                           string="Tipe" invisible="ya_discount_mode != 'global'"/>
                    <field name="ya_global_discount_value"
                           string="Diskon Global" invisible="ya_discount_mode != 'global'"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='ya_purchase_price']" position="after">
                <field name="ya_line_discount_type" string="Tipe" width="65px"
                       column_invisible="parent.ya_discount_mode != 'line'"/>
                <field name="ya_line_discount_value" string="Diskon" width="100px"
                       column_invisible="parent.ya_discount_mode != 'line'"/>
            </xpath>
        </field>
    </record>
</odoo>
