<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ya_store_ro_list" model="ir.ui.view">
    <field name="name">ya.store.ro.list</field>
    <field name="model">ya.store.ro</field>
    <field name="arch" type="xml">
      <list string="RO Toko" create="false" delete="false">
        <header>
          <button name="action_open_upload" type="object"
                  string="Upload RO Baru" display="always"
                  class="btn-primary" groups="mrp.group_mrp_manager"/>
        </header>
        <field name="delivery_date_yyyymmdd" string="Tgl Kirim"/>
        <field name="ro_date_yyyymmdd" string="Tgl RO"/>
        <field name="slot"/>
        <field name="kitchen_code"/>
        <field name="store_warehouse_id"/>
        <field name="line_count"/>
        <field name="qty_total"/>
        <field name="state"/>
      </list>
    </field>
  </record>
  <record id="view_ya_store_ro_form" model="ir.ui.view">
    <field name="name">ya.store.ro.form</field>
    <field name="model">ya.store.ro</field>
    <field name="arch" type="xml">
      <form string="RO Toko" create="false" delete="false">
        <header>
          <button name="action_confirm" type="object" string="Confirm RO"
                  class="btn-primary" groups="mrp.group_mrp_manager"
                  invisible="state != 'draft'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="planning_id" readonly="1"/>
              <field name="delivery_date_yyyymmdd" readonly="1"/>
              <field name="ro_date_yyyymmdd" readonly="1"/>
              <field name="slot" readonly="1"/>
              <field name="kitchen_code" readonly="1"/>
            </group>
            <group>
              <field name="store_warehouse_id" readonly="1"/>
              <field name="source_filename" readonly="1"/>
              <field name="line_count" readonly="1"/>
              <field name="qty_total" readonly="1"/>
              <field name="confirmed_at" readonly="1"/>
              <field name="confirmed_by" readonly="1"/>
            </group>
          </group>
          <notebook>
            <page string="Qty Pesan per SKU">
              <field name="line_ids" readonly="state == 'confirmed'">
                <list editable="bottom" create="false" delete="false">
                  <field name="reference" readonly="1"/>
                  <field name="product_id" readonly="1"/>
                  <field name="qty_requested" string="Qty Pesan"/>
                  <field name="uom_id" readonly="1"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
  <record id="view_ya_store_ro_search" model="ir.ui.view">
    <field name="name">ya.store.ro.search</field>
    <field name="model">ya.store.ro</field>
    <field name="arch" type="xml">
      <search>
        <field name="delivery_date"/>
        <field name="store_warehouse_id"/>
        <field name="kitchen_code"/>
        <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
        <filter name="confirmed" string="Confirmed" domain="[('state','=','confirmed')]"/>
        <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
        <filter name="group_store" string="Toko" context="{'group_by':'store_warehouse_id'}"/>
      </search>
    </field>
  </record>
  <record id="action_ya_store_ro" model="ir.actions.act_window">
    <field name="name">RO Toko</field>
    <field name="res_model">ya.store.ro</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_ya_store_ro_search"/>
  </record>
  <menuitem id="menu_ya_store_ro"
            name="RO Toko"
            parent="ya_production_planning.menu_ya_capacity_root"
            action="action_ya_store_ro"
            sequence="20"
            groups="mrp.group_mrp_manager"/>
</odoo>
