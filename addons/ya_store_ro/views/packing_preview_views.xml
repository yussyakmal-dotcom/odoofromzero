<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ya_packing_preview_form" model="ir.ui.view">
    <field name="name">ya.packing.preview.form</field>
    <field name="model">ya.packing.preview</field>
    <field name="arch" type="xml">
      <form string="Packing Consolidation - RO Only" create="false" delete="false">
        <group>
          <field name="delivery_date_yyyymmdd" readonly="1"/>
          <field name="slot" readonly="1"/>
          <field name="selected_count" readonly="1" string="RO Confirmed Dipilih"/>
          <field name="selected_ro_ids" readonly="1" widget="many2many_tags"
                 options="{'no_create': True, 'no_open': True}"/>
          <field name="state" invisible="1"/>
        </group>
        <!-- Visual gate: clear warning before the SKU grid, not a silent missing button. -->
        <div class="alert alert-danger" role="alert"
             invisible="state != 'preview' or blocked_count == 0">
          <strong>PERINGATAN KAPASITAS!</strong>
          <field name="blocked_count" readonly="1" nolabel="1"
                 class="fw-bold"/>
          <span> SKU tidak bisa diproduksi bahkan 1 batch BoM dalam Planning Max.
            Baris ini ditandai merah. Perbaiki kapasitas atau Qty/BoM dahulu.
            Prorata toko tidak dapat membuat kurang dari satu batch.
          </span>
        </div>
        <div class="alert alert-warning" role="alert"
             invisible="state != 'preview' or prorated_count == 0">
          <strong>PRORATA KAPASITAS:</strong>
          <field name="prorated_count" readonly="1" nolabel="1"/>
          <span> SKU dibatasi Planning Max. Total kekurangan toko </span>
          <field name="total_shortage" readonly="1" nolabel="1"/>
          <span> pcs. Cek jatah final dan kekurangan pada tab Prorata per Toko.
            Qty RO asli tidak berubah. Setujui pembagian sebelum Pre Produksi.
          </span>
        </div>
        <group invisible="state != 'preview'">
          <group>
            <field name="ro_count" readonly="1"/>
            <field name="kitchen_count" readonly="1"/>
            <field name="sku_count" readonly="1"/>
            <field name="blocked_count" readonly="1"/>
            <field name="prorated_count" readonly="1"/>
            <field name="total_shortage" readonly="1"/>
          </group>
          <group>
            <field name="total_requested" readonly="1"/>
            <field name="total_production" readonly="1"/>
          </group>
          <field name="info" readonly="1" nolabel="1" colspan="2"/>
        </group>
        <notebook invisible="state != 'preview'">
          <page string="Consolidated SKU">
            <field name="line_ids" readonly="1" nolabel="1">
              <list create="false" delete="false"
                    decoration-danger="capacity_status == 'blocked'"
                    decoration-warning="capacity_status == 'prorated'">
                <field name="kitchen_code" string="Dapur"/>
                <field name="reference"/>
                <field name="product_id"/>
                <field name="qty_requested" string="Total RO"/>
                <field name="bom_output" string="BoM Output"/>
                <field name="qty_production" string="Production (Round Up)"/>
                <field name="qty_surplus" string="Surplus"/>
                <field name="qty_shortage" string="Kekurangan"/>
                <field name="max_capacity" string="Planning Max"/>
                <field name="capacity_status" string="Capacity" widget="badge"
                       decoration-danger="capacity_status == 'blocked'"
                       decoration-warning="capacity_status == 'prorated'"
                       decoration-success="capacity_status == 'ok'"/>
                <field name="uom_id"/>
              </list>
            </field>
          </page>
          <page string="Koreksi Qty RO - Sebelum Pre Produksi">
            <field name="source_line_ids" nolabel="1">
              <list editable="bottom" create="false" delete="false">
                <field name="kitchen_code" string="Dapur" readonly="1"/>
                <field name="reference" string="SKU" readonly="1"/>
                <field name="store_warehouse_id" string="Toko" readonly="1"/>
                <field name="ro_id" readonly="1"/>
                <field name="old_qty" string="Qty Confirmed" readonly="1"/>
                <field name="new_qty" string="Qty Koreksi"/>
                <field name="reason" string="Alasan (wajib jika Qty berubah)"/>
              </list>
            </field>
          </page>
          <page string="Prorata per Toko">
            <field name="allocation_ids" readonly="1" nolabel="1">
              <list create="false" delete="false">
                <field name="kitchen_code" string="Dapur"/>
                <field name="reference"/>
                <field name="store_warehouse_id" string="Toko"/>
                <field name="ro_id" string="RO Toko"/>
                <field name="ro_date_yyyymmdd" string="Tgl RO"/>
                <field name="delivery_date_yyyymmdd" string="Tgl Kirim"/>
                <field name="qty_requested" string="RO Qty"/>
                <field name="qty_surplus" string="Surplus Prorata"/>
                <field name="qty_shortage" string="Kekurangan" decoration-danger="qty_shortage &gt; 0"/>
                <field name="qty_allocated" string="Jatah Final"/>
              </list>
            </field>
          </page>
        </notebook>
        <group invisible="state != 'preview' or prorated_count == 0">
          <field name="accept_shortage"
                 string="Saya menyetujui jatah prorata dan kekurangan toko yang ditampilkan."/>
        </group>
        <footer>
          <span class="text-danger fw-bold"
                invisible="state != 'preview' or blocked_count == 0">
            BLOKIR: Planning Max kurang dari 1 batch BoM. Perbaiki SKU merah.
          </span>
          <button name="action_preview" type="object" class="btn-primary"
                  string="Calculate Preview" invisible="state == 'preview'"/>
          <button name="action_apply_corrections" type="object"
                  string="Simpan Koreksi Qty + Recalculate"
                  groups="ya_store_ro.group_ya_packing_admin"
                  invisible="state != 'preview'"/>
          <button name="action_preview" type="object"
                  string="Recalculate" invisible="state != 'preview'"/>
          <span class="text-warning fw-bold"
                invisible="state != 'preview' or prorated_count == 0">
            Periksa dan setujui prorata kekurangan toko sebelum Pre Produksi.
          </span>
          <button name="action_move_to_preproduction" type="object"
                  string="Pindahkan ke Pre Produksi"
                  class="btn-primary"
                  groups="ya_store_ro.group_ya_packing_admin"
                  confirm="Pindahkan konsolidasi ke Pre Produksi dan KUNCI Qty? Jika kapasitas kurang, Qty permintaan toko tidak berubah, tetapi jatah final masing-masing toko berkurang dan kekurangan dicatat. MO BELUM dibuat."
                  invisible="state != 'preview' or blocked_count != 0"/>
          <button string="Close" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
  <record id="action_ya_packing_preview" model="ir.actions.act_window">
    <field name="name">Packing Consolidation (RO Only)</field>
    <field name="res_model">ya.packing.preview</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
  <!-- Packing menu now points to a list of CONFIRMED RO, not this modal. -->
</odoo>
