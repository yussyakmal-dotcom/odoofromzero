<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Each row is an existing batch + kitchen. Menu stays at Packing batch list.
       User enters child LIST, selects kitchen FORM, then explicit confirmation. -->
  <record id="view_ya_cdc_pick_confirmation_list" model="ir.ui.view">
    <field name="name">ya.cdc.pick.confirmation.list</field>
    <field name="model">ya.cdc.pick.confirmation</field>
    <field name="arch" type="xml">
      <list string="Konfirmasi Picking CDC per Dapur" create="false"
            edit="false" delete="false">
        <field name="name"/>
        <field name="batch_id"/>
        <field name="warehouse_id"/>
        <field name="cdc_warehouse_id"/>
        <field name="state"/>
        <field name="confirmed_by"/>
        <field name="confirmed_at_label"/>
        <field name="internal_transfer_id" string="Internal Transfer Odoo"/>
      </list>
    </field>
  </record>

  <record id="view_ya_cdc_pick_confirmation_form" model="ir.ui.view">
    <field name="name">ya.cdc.pick.confirmation.form</field>
    <field name="model">ya.cdc.pick.confirmation</field>
    <field name="arch" type="xml">
      <form string="Konfirmasi Qty Picking Fisik CDC"
            create="false" delete="false">
        <header>
          <button name="action_confirm_qty" type="object"
                  string="Konfirmasi Qty Picking" class="btn-primary"
                  invisible="state != 'draft'"/>
          <button name="action_create_internal_transfer" type="object"
                  string="Buat Internal Transfer Odoo" class="btn-primary"
                  invisible="state != 'confirmed' or internal_transfer_id"/>
          <button name="action_open_internal_transfer" type="object"
                  string="Buka Internal Transfer"
                  invisible="not internal_transfer_id"/>
          <field name="state" widget="statusbar"
                 statusbar_visible="draft,confirmed"/>
        </header>
        <sheet>
          <div class="alert alert-info" role="alert">
            Ini konfirmasi pengambilan fisik, BUKAN Internal Transfer.
            Qty lebih besar dari kebutuhan MO boleh untuk Special Transfer ke
            dapur tujuan yang sama, dengan centang dan alasan.
            Tambahan menjadi stok dapur, BUKAN penambahan konsumsi MO.
            Tombol Buat Internal Transfer membuat dokumen standar Odoo
            (CDC ke dapur ini). Pengisian Qty dapat melakukan reservasi stok
            dan mengubah status menjadi Ready, tetapi TIDAK melakukan
            validasi atau perpindahan stok. Periksa stok dan rute dahulu.
            Lot hanya diperlukan bila produk memang memakai tracking.
          </div>
          <group>
            <group>
              <field name="name" readonly="1"/>
              <field name="batch_id" readonly="1"/>
              <field name="warehouse_id" readonly="1"/>
              <field name="cdc_warehouse_id" readonly="1"/>
            </group>
            <group>
              <field name="confirmed_by" readonly="1"/>
              <field name="confirmed_at_label" readonly="1"/>
              <field name="internal_transfer_id" readonly="1"
                     options="{'no_create': True, 'no_create_edit': True}"/>
            </group>
          </group>
          <field name="info" readonly="1" nolabel="1"/>
          <notebook>
            <page string="Qty Fisik dan Special Transfer">
              <field name="line_ids" nolabel="1"
                     readonly="state != 'draft'">
                <list editable="bottom" create="true" delete="true">
                  <field name="product_id" required="1"
                         options="{'no_create': True, 'no_create_edit': True}"/>
                  <field name="requested_qty" readonly="1"
                         string="Qty Picking List (MO)"/>
                  <field name="picked_qty" string="Qty Fisik Dipicking"/>
                  <field name="special_qty" readonly="1"
                         string="Qty Extra / Special"/>
                  <field name="uom_id" readonly="1"/>
                  <field name="special_transfer" string="Special Transfer?"/>
                  <field name="special_reason" string="Alasan Special"/>
                  <field name="special_reference" string="Referensi Special"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
