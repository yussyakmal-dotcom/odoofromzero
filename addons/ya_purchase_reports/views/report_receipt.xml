<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="ya_picking_print_received_units" inherit_id="stock.report_picking">
        <!-- Physical receipt summary is based on stock.move snapshots rather than
             split stock.move.line details. The native technical table remains. -->
        <xpath expr="//div[hasclass('o_stock_report_header_row')]" position="after">
            <div t-if="o.picking_type_code == 'incoming' and any(m.ya_received_unit_label for m in o.move_ids)"
                 class="mt-3 mb-3">
                <strong>Ringkasan Penerimaan Fisik</strong>
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th>Produk</th>
                            <th class="text-end">Diterima</th>
                            <th class="text-end">Stok Dasar</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.move_ids" t-as="physical_move">
                            <t t-if="physical_move.ya_received_unit_label">
                                <td><span t-field="physical_move.product_id"/></td>
                                <td class="text-end">
                                    <span t-out="physical_move.ya_received_unit_qty"/>
                                    <span t-out="physical_move.ya_received_unit_label"/>
                                </td>
                                <td class="text-end">
                                    <span t-out="physical_move.quantity"/>
                                    <span t-field="physical_move.product_uom"/>
                                </td>
                            </t>
                        </tr>
                    </tbody>
                </table>
            </div>
        </xpath>
        <!-- For ordinary incoming YA receipts with complete physical snapshots,
             show the physical summary instead of duplicated technical split rows.
             Keep native stock detail for lot/serial-tracked receipts and for
             partial/missing snapshot data. -->
        <xpath expr="//table[.//span[@t-out='format_number(line.quantity)']]" position="attributes">
            <attribute name="t-if">o.move_line_ids and o.move_ids.move_line_ids.filtered(lambda ml: not ml.is_entire_pack) and not (o.picking_type_id.code == 'incoming' and all(m.ya_received_unit_label for m in o.move_ids.filtered(lambda m: m.quantity)) and not any(ml.lot_id or ml.lot_name for ml in o.move_line_ids))</attribute>
        </xpath>
        <!-- Use physical snapshots for aggregated rows, even if Odoo split the
             technical move lines during validation. -->
        <xpath expr="//span[@t-out='format_number(move.quantity)']" position="replace">
            <span t-if="move.ya_received_unit_label" t-out="move.ya_received_unit_qty"/>
            <span t-else="" t-out="format_number(move.quantity)"/>
        </xpath>
        <xpath expr="//span[@t-field='move.product_uom']" position="replace">
            <span t-if="move.ya_received_unit_label" t-out="move.ya_received_unit_label"/>
            <span t-else="" t-field="move.product_uom" groups="uom.group_uom"/>
        </xpath>
        <!-- Detailed tracked or split lines retain their exact stock quantities.
             The physical receipt total is annotated only once per move. -->
        <xpath expr="//span[@t-out='format_number(line.quantity)']" position="replace">
            <span t-if="line.move_id and line.move_id.ya_received_unit_label and len(line.move_id.move_line_ids) == 1 and abs(line.quantity - line.move_id.quantity) &lt; 0.0000001"
                  t-out="line.move_id.ya_received_unit_qty"/>
            <span t-else="" t-out="format_number(line.quantity)"/>
            <span t-if="line.move_id and line.move_id.ya_received_unit_label and len(line.move_id.move_line_ids) &gt; 1 and line.id == min(line.move_id.move_line_ids.ids)"
                  class="text-muted small">
                (Total diterima: <span t-out="line.move_id.ya_received_unit_qty"/>
                <span t-out="line.move_id.ya_received_unit_label"/>)
            </span>
        </xpath>
        <xpath expr="//span[@t-field='line.product_uom_id']" position="replace">
            <span t-if="line.move_id and line.move_id.ya_received_unit_label and len(line.move_id.move_line_ids) == 1 and abs(line.quantity - line.move_id.quantity) &lt; 0.0000001"
                  t-out="line.move_id.ya_received_unit_label"/>
            <span t-else="" t-field="line.product_uom_id" groups="uom.group_uom"/>
        </xpath>
    </template>
</odoo>
