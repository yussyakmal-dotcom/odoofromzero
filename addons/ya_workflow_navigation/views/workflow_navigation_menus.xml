<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Only structure existing menus; don't change workflow actions or rights. -->
  <menuitem id="menu_ya_before_production" name="SEBELUM PRODUKSI"
            parent="ya_production_planning.menu_ya_capacity_root"
            sequence="10" groups="mrp.group_mrp_user,mrp.group_mrp_manager"/>
  <menuitem id="menu_ya_during_production" name="PROSES PRODUKSI"
            parent="ya_production_planning.menu_ya_capacity_root"
            sequence="20" groups="mrp.group_mrp_user,mrp.group_mrp_manager"/>
  <menuitem id="menu_ya_after_production" name="SESUDAH PRODUKSI"
            parent="ya_production_planning.menu_ya_capacity_root"
            sequence="30" groups="mrp.group_mrp_user,mrp.group_mrp_manager"/>

  <!-- BEFORE: production planning, store requests and RO consolidation. -->
  <record id="ya_production_planning.menu_ya_capacity_plans" model="ir.ui.menu">
    <field name="parent_id" ref="menu_ya_before_production"/>
    <field name="sequence" eval="10"/>
  </record>
  <record id="ya_store_ro.menu_ya_store_ro_template" model="ir.ui.menu">
    <field name="parent_id" ref="menu_ya_before_production"/>
    <field name="sequence" eval="15"/>
  </record>
  <record id="ya_store_ro.menu_ya_store_ro" model="ir.ui.menu">
    <field name="parent_id" ref="menu_ya_before_production"/>
    <field name="sequence" eval="20"/>
  </record>
  <record id="ya_store_ro.menu_ya_packing_qty_correction" model="ir.ui.menu">
    <field name="parent_id" ref="menu_ya_before_production"/>
    <field name="name">RO Confirmed Koreksi</field>
    <field name="sequence" eval="30"/>
  </record>
  <record id="ya_store_ro.menu_ya_packing_preview" model="ir.ui.menu">
    <field name="parent_id" ref="menu_ya_before_production"/>
    <field name="name">RO Konsolidasi</field>
    <field name="sequence" eval="40"/>
  </record>
  <!-- Pre Produksi was historically hidden; expose its existing list,
       preserving the action that requires selecting all SKU before MO release. -->
  <record id="ya_store_ro.menu_ya_packing_preproduction" model="ir.ui.menu">
    <field name="parent_id" ref="menu_ya_before_production"/>
    <field name="name">Pre Produksi</field>
    <field name="sequence" eval="50"/>
    <field name="active" eval="True"/>
  </record>

  <!-- DURING: material requisitions and native MOs. -->
  <record id="ya_material_requirement.menu_ya_material_requirement" model="ir.ui.menu">
    <field name="parent_id" ref="menu_ya_during_production"/>
    <field name="sequence" eval="10"/>
  </record>
  <record id="action_ya_mo_production" model="ir.actions.act_window">
    <field name="name">MO Produksi</field>
    <field name="res_model">mrp.production</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('ya_packing_batch_line_id', '!=', False)]</field>
  </record>
  <menuitem id="menu_ya_mo_production" name="MO Produksi"
            parent="menu_ya_during_production"
            action="action_ya_mo_production"
            sequence="20"
            groups="mrp.group_mrp_user,mrp.group_mrp_manager"/>

  <!-- AFTER: list of completed-production batches; button is on the FORM.
       Do not activate the old duplicate Packing batch menu. -->
  <record id="ya_finished_packing_transfer.ya_fg_packing_batch_menu" model="ir.ui.menu">
    <field name="parent_id" ref="menu_ya_after_production"/>
    <field name="name">Produk Jadi ke Packing</field>
    <field name="sequence" eval="10"/>
  </record>
</odoo>
