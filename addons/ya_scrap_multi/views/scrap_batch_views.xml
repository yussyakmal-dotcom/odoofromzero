<odoo>
  <record id="view_ya_scrap_batch_list" model="ir.ui.view">
    <field name="name">ya.scrap.batch.list</field>
    <field name="model">ya.scrap.batch</field>
    <field name="arch" type="xml">
      <list string="Multi-SKU Scrap" create="1">
        <field name="name"/>
        <field name="source_document"/>
        <field name="location_id"/>
        <field name="scrap_location_id"/>
        <field name="reason_tag_id"/>
        <field name="company_id" groups="base.group_multi_company"/>
        <field name="state"/>
      </list>
    </field>
  </record>
  <record id="view_ya_scrap_batch_form" model="ir.ui.view">
    <field name="name">ya.scrap.batch.form</field>
    <field name="model">ya.scrap.batch</field>
    <field name="arch" type="xml">
      <form string="Multi-SKU Scrap">
        <header>
          <button name="action_validate" type="object" string="Validate All Scrap" class="btn-primary"
                  invisible="state != 'draft'" confirm="Validate all product lines and create native Scrap transactions?"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_scraps" type="object" class="oe_stat_button" icon="fa-exchange"
                    invisible="state != 'done'">
              <field name="scrap_count" widget="statinfo" string="Scrap Transactions"/>
            </button>
          </div>
          <h1><field name="name" readonly="1"/></h1>
          <group>
            <group>
              <field name="company_id" groups="base.group_multi_company"
                     readonly="state != 'draft'"/>
              <field name="location_id" readonly="state != 'draft'"
                     options="{'no_create': True}"/>
              <field name="scrap_location_id" readonly="state != 'draft'"
                     options="{'no_create': True}"/>
            </group>
            <group>
              <field name="source_document" readonly="state != 'draft'"/>
              <field name="reason_tag_id" readonly="state != 'draft'"
                     options="{'no_create': True}"/>
            </group>
          </group>
          <notebook>
            <page string="Scrap Products">
              <field name="line_ids" readonly="state != 'draft'">
                <list editable="bottom">
                  <field name="product_id"/>
                  <field name="qty"/>
                  <field name="uom_id"/>
                </list>
              </field>
            </page>
            <page string="Excel Import" invisible="state != 'draft'">
              <group>
                <field name="import_file" filename="import_filename"/>
                <field name="import_filename" invisible="1"/>
              </group>
              <div class="d-flex gap-2">
                <button name="action_download_template" type="object"
                        string="Download Excel Template" class="btn-secondary"/>
                <button name="action_import_xlsx" type="object"
                        string="Import Excel Lines" class="btn-primary"
                        confirm="Add Excel lines to the current document?"/>
              </div>
              <p>Excel columns: SKU | Quantity | UoM. UoM may be blank to use the product base unit.</p>
              <p>Excel import adds lines to existing lines. Nothing is scrapped until Validate All Scrap is clicked.</p>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_ya_scrap_batch" model="ir.actions.act_window">
    <field name="name">Multi-SKU Scrap</field>
    <field name="res_model">ya.scrap.batch</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_ya_scrap_batch" name="Multi-SKU Scrap"
            parent="stock.menu_stock_root" action="action_ya_scrap_batch"
            groups="stock.group_stock_user" sequence="85"/>
</odoo>
