<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ya_package_store_ro_list" model="ir.ui.view">
    <field name="name">ya.package.store.ro.list</field>
    <field name="model">ya.package.store.ro</field>
    <field name="arch" type="xml">
      <list string="RO Paket Toko" delete="false">
        <field name="name"/>
        <field name="delivery_date"/>
        <field name="slot"/>
        <field name="store_warehouse_id"/>
        <field name="line_count"/>
        <field name="qty_total"/>
        <field name="state"/>
      </list>
    </field>
  </record>
  <record id="view_ya_package_store_ro_form" model="ir.ui.view">
    <field name="name">ya.package.store.ro.form</field>
    <field name="model">ya.package.store.ro</field>
    <field name="arch" type="xml">
      <form string="RO Paket Toko" delete="false">
        <header>
          <button name="action_confirm" type="object" string="Confirm Paket RO"
                  class="btn-primary" groups="ya_package_store_ro.group_ya_package_ro_creator"
                  invisible="state != 'draft'"/>
          <button name="action_open_packing_qty_correction" type="object"
                  string="Koreksi Qty (Packing)"
                  groups="ya_store_ro.group_ya_packing_admin"
                  invisible="state != 'confirmed'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="delivery_date" readonly="state == 'confirmed'"/>
              <field name="slot" readonly="state == 'confirmed'"/>
              <field name="store_warehouse_id" readonly="state == 'confirmed'"/>
            </group>
            <group>
              <field name="qty_total" readonly="1"/>
              <field name="confirmed_at" readonly="1"/>
              <field name="confirmed_by" readonly="1"/>
            </group>
          </group>
          <field name="line_ids" readonly="state == 'confirmed'">
            <list editable="bottom">
              <field name="product_id"/>
              <field name="qty_requested"/>
              <field name="uom_id" readonly="1"/>
            </list>
          </field>
          <notebook>
            <page string="Riwayat Koreksi Packing">
              <field name="correction_ids" readonly="1">
                <list create="false" delete="false">
                  <field name="product_id"/>
                  <field name="qty_before"/>
                  <field name="qty_after"/>
                  <field name="reason"/>
                  <field name="changed_by"/>
                  <field name="changed_at"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_ya_package_store_ro" model="ir.actions.act_window">
    <field name="name">RO Paket Toko</field>
    <field name="res_model">ya.package.store.ro</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_ya_package_store_ro_list"/>
  </record>
  <menuitem id="menu_ya_package_ro_root" name="YA RO Paket"
            sequence="75"
            groups="ya_package_store_ro.group_ya_package_ro_creator,ya_store_ro.group_ya_packing_admin"/>
  <menuitem id="menu_ya_package_store_ro" name="RO Paket Toko"
            parent="menu_ya_package_ro_root"
            action="action_ya_package_store_ro"
            sequence="21" groups="ya_package_store_ro.group_ya_package_ro_creator,ya_store_ro.group_ya_packing_admin"/>
</odoo>
