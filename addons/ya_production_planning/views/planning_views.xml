<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ya_production_planning_list" model="ir.ui.view">
    <field name="name">ya.production.planning.list</field>
    <field name="model">ya.production.planning</field>
    <field name="arch" type="xml">
      <list string="Production Planning" create="false" delete="false">
        <header>
          <button name="action_open_upload_wizard" type="object"
                  string="Upload Baru" display="always"
                  groups="mrp.group_mrp_manager" class="btn-primary"/>
        </header>
        <field name="delivery_date"/>
        <field name="slot"/>
        <field name="kitchen_code"/>
        <field name="workcenter_id"/>
        <field name="line_count"/>
        <field name="state"/>
      </list>
    </field>
  </record>
  <record id="view_ya_production_planning_form" model="ir.ui.view">
    <field name="name">ya.production.planning.form</field>
    <field name="model">ya.production.planning</field>
    <field name="arch" type="xml">
      <form string="Production Planning" create="false" delete="false">
        <header>
          <button name="action_publish" type="object" string="Publish This Kitchen"
                  class="btn-primary" groups="mrp.group_mrp_manager" invisible="state != 'draft'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,published"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="delivery_date" readonly="1"/>
              <field name="slot" readonly="1"/>
              <field name="kitchen_code" readonly="1"/>
              <field name="workcenter_id" readonly="1"/>
            </group>
            <group>
              <field name="upload_filename" readonly="1"/>
              <field name="line_count" readonly="1"/>
              <field name="published_at" readonly="1"/>
              <field name="published_by" readonly="1"/>
            </group>
          </group>
          <notebook>
            <page string="Max Capacity by SKU">
              <field name="line_ids" readonly="state == 'published'">
                <list editable="bottom" create="false" delete="false">
                  <field name="line_row" string="Line Row" readonly="1" width="75px"/>
                  <field name="reference" readonly="1"/>
                  <field name="product_id" readonly="1"/>
                  <field name="max_capacity" string="Max Capacity"/>
                  <field name="uom_id" readonly="1"/>
                  <field name="source_sheet" readonly="1"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
  <record id="view_ya_production_planning_search" model="ir.ui.view">
    <field name="name">ya.production.planning.search</field>
    <field name="model">ya.production.planning</field>
    <field name="arch" type="xml">
      <search string="Production Planning">
        <field name="delivery_date"/>
        <field name="kitchen_code"/>
        <field name="workcenter_id"/>
        <filter name="filter_draft" string="Draft" domain="[('state','=','draft')]"/>
        <filter name="filter_published" string="Published" domain="[('state','=','published')]"/>
        <separator/>
        <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
        <filter name="group_slot" string="Delivery Slot" context="{'group_by':'slot'}"/>
        <filter name="group_kitchen" string="Kitchen" context="{'group_by':'kitchen_code'}"/>
      </search>
    </field>
  </record>
  <record id="action_ya_production_planning" model="ir.actions.act_window">
    <field name="name">Production Planning</field>
    <field name="res_model">ya.production.planning</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_ya_production_planning_search"/>
    <field name="domain">[]</field>
  </record>
  <menuitem id="menu_ya_capacity_root" name="YA Production Capacity"
            parent="mrp.menu_mrp_root" sequence="60" groups="mrp.group_mrp_user,mrp.group_mrp_manager"/>
  <menuitem id="menu_ya_capacity_plans" name="Production Planning"
            parent="menu_ya_capacity_root" action="action_ya_production_planning" sequence="10"/>
</odoo>
