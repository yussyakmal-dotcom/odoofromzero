<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_ya_receiving_units" model="ir.ui.view">
        <field name="name">stock.picking.form.ya.receiving.units</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Standard Operations rows are the only receiving-entry surface.
                 Keep the native stock quantities for other picking types. -->
            <xpath expr="//field[@name='move_ids']//field[@name='product_uom_qty']" position="attributes">
                <attribute name="column_invisible">parent.picking_type_code == 'incoming'</attribute>
            </xpath>
            <xpath expr="//field[@name='move_ids']//field[@name='product_uom_qty']" position="after">
                <field name="ya_demand_display" string="Demand"
                       readonly="1"
                       column_invisible="parent.picking_type_code != 'incoming'"/>
            </xpath>
            <xpath expr="//field[@name='move_ids']//field[@name='quantity']" position="attributes">
                <attribute name="column_invisible">parent.picking_type_code == 'incoming'</attribute>
            </xpath>
            <xpath expr="//field[@name='move_ids']//field[@name='quantity']" position="after">
                <field name="ya_receipt_qty_units" string="Quantity"
                       column_invisible="parent.picking_type_code != 'incoming'"
                       readonly="parent.state in ('done', 'cancel')"/>
                <field name="ya_receipt_rule_id" string="Unit"
                       domain="[('product_id', '=', product_id), ('active', '=', True)]"
                       options="{'no_create': True, 'no_open': True}"
                       column_invisible="parent.picking_type_code != 'incoming'"
                       readonly="parent.state in ('done', 'cancel')"/>
            </xpath>
            <xpath expr="//field[@name='move_ids']//field[@name='product_uom']" position="attributes">
                <attribute name="column_invisible">parent.picking_type_code == 'incoming'</attribute>
            </xpath>
        </field>
    </record>
</odoo>
